<div class="relative w-full py-10">

    <!-- Separator -->
    <div class="absolute left-4 top-0 h-full w-px bg-gray-300
                md:left-1/2 md:-translate-x-1/2">
    </div>

    <div class="!space-y-8 md:!space-y-0">

        @for (int i = 0; i < TimelineItems.Count; i++)
        {
            var item = TimelineItems[i];
            var isLeft = i % 2 == 0;

            <div class="relative grid grid-cols-1
                        md:grid-cols-2 md:gap-8">

                <TimelineItem
                    item="@(item)"
                    isLeft="@(isLeft)" />

                <!-- Timeline dot -->
                <div class="absolute left-4 top-1/2 z-10
                            h-4 w-4
                            -translate-x-1/2 -translate-y-1/2
                            rounded-full
                            border-4 border-white
                            bg-[#550b14]
                            md:left-1/2">
                </div>

            </div>
        }

    </div>
</div>

@code {
    [Parameter]
    public List<TimelineItemDTO> TimelineItems { get; set; } = new();
}