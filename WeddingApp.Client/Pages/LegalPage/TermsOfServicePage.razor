@page "/terms-of-service"
<PageTitle>Terms of Service | Mr. & Mrs. Gernale</PageTitle>

<section id="terms-of-service-section" class="bg-white relative w-full min-h-screen flex justify-center z-1 !px-6 !pt-[100px] !pb-16 sm:!px-10">

    <div class="bg-dotted-pattern-edges h-full w-full absolute inset-0 pointer-events-none"></div>

    <div class="relative z-5 flex w-full max-w-3xl flex-col items-center gap-4">
        <p class="page-title">Terms of Service</p>
        <p class="!m-0 text-center !text-[13px] !text-[#6B7369]">Last updated: @LastUpdated</p>

        <!-- Divider -->
        <div class="flex w-full max-w-xs items-center gap-4 !py-[20px]">
            <div class="h-px flex-1 bg-black/20"></div>
            <FlowerIcon Width="10px" Height="10px" />
            <div class="h-px flex-1 bg-black/20"></div>
        </div>

        <article class="flex w-full flex-col gap-8 rounded-2xl border border-[#dbdfd9] bg-white !p-6 shadow-xl sm:!p-10">

            <div class="flex flex-col gap-2">
                <h2 class="!m-0 !text-[20px] font-bold !text-[#550b14]">Acceptance of these terms</h2>
                <p class="!m-0">
                    By using <strong>thegernales.com</strong>, the personal wedding website of John Matthew Gernale and
                    Erika Joyce Gatchalian ("we", "us", "our"), you agree to these terms. If you do not agree, please do not
                    use the website.
                </p>
            </div>

            <div class="flex flex-col gap-2">
                <h2 class="!m-0 !text-[20px] font-bold !text-[#550b14]">Purpose of this website</h2>
                <p class="!m-0">
                    This is a non-commercial website that shares information about our wedding, lets invited guests RSVP,
                    and hosts a shared photo gallery of our celebration. Event details such as schedules and venues may
                    change, and we will do our best to keep this website up to date.
                </p>
            </div>

            <div class="flex flex-col gap-2">
                <h2 class="!m-0 !text-[20px] font-bold !text-[#550b14]">Sharing photos</h2>
                <p class="!m-0">When you upload a photo to our gallery, you confirm that:</p>
                <ul class="!m-0 list-disc !pl-5 flex flex-col gap-2 text-[#666]">
                    <li>You took the photo or have the right to share it.</li>
                    <li>The people in the photo would be comfortable with it being shared.</li>
                    <li>The photo is appropriate for a family celebration and is not offensive, harmful, or unlawful.</li>
                </ul>
                <p class="!m-0">
                    You keep ownership of your photos. By sharing one, you allow us to store it in our private Google Drive,
                    display it on this website, and keep it as a personal memory of our wedding. We may remove any photo at
                    our discretion, and you may ask us to remove a photo you shared at any time.
                </p>
            </div>

            <div class="flex flex-col gap-2">
                <h2 class="!m-0 !text-[20px] font-bold !text-[#550b14]">Acceptable use</h2>
                <p class="!m-0">
                    Please do not misuse this website — for example, by uploading malicious files, attempting to access data
                    you are not meant to, disrupting the website, or collecting other guests' photos for purposes outside
                    our celebration.
                </p>
            </div>

            <div class="flex flex-col gap-2">
                <h2 class="!m-0 !text-[20px] font-bold !text-[#550b14]">Third-party services</h2>
                <p class="!m-0">
                    This website relies on services such as Google Drive, Google Forms, and Google Maps. Gift details for
                    GCash and BPI are provided for convenience, and any transaction is handled by those providers under
                    their own terms. We are not responsible for the content or practices of third-party services.
                </p>
            </div>

            <div class="flex flex-col gap-2">
                <h2 class="!m-0 !text-[20px] font-bold !text-[#550b14]">Disclaimer</h2>
                <p class="!m-0">
                    This website is provided "as is" without warranties of any kind. To the extent permitted by law, we are
                    not liable for any loss or damage arising from your use of the website.
                </p>
            </div>

            <div class="flex flex-col gap-2">
                <h2 class="!m-0 !text-[20px] font-bold !text-[#550b14]">Privacy</h2>
                <p class="!m-0">
                    Please read our
                    <a href="/privacy-policy" class="!text-[#550b14] underline underline-offset-4">Privacy Policy</a>
                    to learn how we handle your information and how we use Google Drive.
                </p>
            </div>

            <div class="flex flex-col gap-2">
                <h2 class="!m-0 !text-[20px] font-bold !text-[#550b14]">Changes to these terms</h2>
                <p class="!m-0">
                    We may update these terms from time to time. Any changes will be posted on this page with an updated date.
                </p>
            </div>

            <div class="flex flex-col gap-2">
                <h2 class="!m-0 !text-[20px] font-bold !text-[#550b14]">Contact us</h2>
                <p class="!m-0">
                    For any questions about these terms, email us at
                    <a href="mailto:@ContactEmail" class="!text-[#550b14] underline underline-offset-4">@ContactEmail</a>.
                </p>
            </div>
        </article>

        <a href="/privacy-policy" class="!pt-[25px] !text-[13px] !text-[#550b14] underline underline-offset-4">Read our Privacy Policy</a>
    </div>
</section>


@code {
    private const string ContactEmail = "matthewgernale26@gmail.com";
    private const string LastUpdated = "September 27, 2026";
}
