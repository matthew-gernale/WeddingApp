@page "/privacy-policy"
<PageTitle>Privacy Policy | Mr. & Mrs. Gernale</PageTitle>

<section id="privacy-policy-section" class="bg-white relative w-full min-h-screen flex justify-center z-1 !px-6 !pt-[100px] !pb-16 sm:!px-10">

    <div class="bg-dotted-pattern-edges h-full w-full absolute inset-0 pointer-events-none"></div>

    <div class="relative z-5 flex w-full max-w-3xl flex-col items-center gap-4">
        <p class="page-title">Privacy Policy</p>
        <p class="!m-0 text-center !text-[13px] !text-[#6B7369]">Last updated: @LastUpdated</p>

        <!-- Divider -->
        <div class="flex w-full max-w-xs items-center gap-4 !py-[20px]">
            <div class="h-px flex-1 bg-black/20"></div>
            <FlowerIcon Width="10px" Height="10px" />
            <div class="h-px flex-1 bg-black/20"></div>
        </div>

        <article class="flex w-full flex-col gap-8 rounded-2xl border border-[#dbdfd9] bg-white !p-6 shadow-xl sm:!p-10">

            <div class="flex flex-col gap-2">
                <h2 class="!m-0 !text-[20px] font-bold !text-[#550b14]">Who we are</h2>
                <p class="!m-0">
                    This website (<strong>thegernales.com</strong>) is the personal wedding website of John Matthew Gernale and
                    Erika Joyce Gatchalian ("we", "us", "our"). It is a non-commercial website made to share details of our
                    wedding with our invited guests. This policy explains what information we collect and how we use it.
                </p>
            </div>

            <div class="flex flex-col gap-2">
                <h2 class="!m-0 !text-[20px] font-bold !text-[#550b14]">Information we collect</h2>
                <ul class="!m-0 list-disc !pl-5 flex flex-col gap-2 text-[#666]">
                    <li><strong>RSVP details</strong> — your name and whether you will attend, submitted through Google Forms.</li>
                    <li><strong>Photos you share</strong> — the image files you upload to our gallery, along with their file name, file type, and upload time.</li>
                    <li><strong>Basic technical data</strong> — our hosting provider may keep standard server logs (such as IP address, browser type, and request time) for security and reliability.</li>
                </ul>
                <p class="!m-0">
                    Guests do not create accounts and never sign in with Google on this website. We do not use advertising,
                    analytics, or tracking cookies.
                </p>
            </div>

            <div class="flex flex-col gap-2">
                <h2 class="!m-0 !text-[20px] font-bold !text-[#550b14]">How we use Google user data</h2>
                <p class="!m-0">
                    Our website's server connects to <strong>our own</strong> Google account through the Google Drive API.
                    This access is used only to:
                </p>
                <ul class="!m-0 list-disc !pl-5 flex flex-col gap-2 text-[#666]">
                    <li>Upload the photos guests choose to share into a single private wedding folder in our Google Drive.</li>
                    <li>List and display the images in that folder on the gallery page of this website.</li>
                </ul>
                <p class="!m-0">
                    We do not read, modify, or delete any other files in our Google Drive, and we do not access the Google
                    accounts of our guests. Google access credentials are kept securely on our server and are never sent to
                    your browser.
                </p>
                <p class="!m-0">
                    Our use and transfer of information received from Google APIs adheres to the
                    <a href="https://developers.google.com/terms/api-services-user-data-policy" target="_blank" rel="noopener noreferrer" class="!text-[#550b14] underline underline-offset-4">Google API Services User Data Policy</a>,
                    including the Limited Use requirements.
                </p>
            </div>

            <div class="flex flex-col gap-2">
                <h2 class="!m-0 !text-[20px] font-bold !text-[#550b14]">How we share information</h2>
                <p class="!m-0">
                    We do not sell, rent, or trade your information. Photos shared to the gallery are visible to visitors of
                    this website. Your information is otherwise only processed by the services that run this website:
                    Google (Google Drive and Google Forms) and Microsoft Azure (website hosting).
                </p>
            </div>

            <div class="flex flex-col gap-2">
                <h2 class="!m-0 !text-[20px] font-bold !text-[#550b14]">Retention and removal</h2>
                <p class="!m-0">
                    RSVP details are kept only as long as needed to plan our wedding. Shared photos are kept in our Google
                    Drive as a keepsake of our day. If you would like a photo or your RSVP details removed, email us at
                    <a href="mailto:@ContactEmail" class="!text-[#550b14] underline underline-offset-4">@ContactEmail</a>
                    and we will remove it promptly.
                </p>
            </div>

            <div class="flex flex-col gap-2">
                <h2 class="!m-0 !text-[20px] font-bold !text-[#550b14]">Security</h2>
                <p class="!m-0">
                    This website is served over HTTPS, and our Google Drive folder is private. Photos are delivered through
                    our own server rather than public Google Drive links. No method of transmission or storage is completely
                    secure, but we take reasonable steps to protect the information you share.
                </p>
            </div>

            <div class="flex flex-col gap-2">
                <h2 class="!m-0 !text-[20px] font-bold !text-[#550b14]">Children's privacy</h2>
                <p class="!m-0">
                    This website is intended for our invited guests and is not directed to children under 13. We do not
                    knowingly collect personal information from children.
                </p>
            </div>

            <div class="flex flex-col gap-2">
                <h2 class="!m-0 !text-[20px] font-bold !text-[#550b14]">Changes to this policy</h2>
                <p class="!m-0">
                    We may update this policy from time to time. Any changes will be posted on this page with an updated date.
                </p>
            </div>

            <div class="flex flex-col gap-2">
                <h2 class="!m-0 !text-[20px] font-bold !text-[#550b14]">Contact us</h2>
                <p class="!m-0">
                    For any questions about this policy, email us at
                    <a href="mailto:@ContactEmail" class="!text-[#550b14] underline underline-offset-4">@ContactEmail</a>.
                </p>
            </div>
        </article>

        <a href="/terms-of-service" class="!pt-[25px] !text-[13px] !text-[#550b14] underline underline-offset-4">Read our Terms of Service</a>
    </div>
</section>


@code {
    private const string ContactEmail = "matthewgernale26@gmail.com";
    private const string LastUpdated = "September 27, 2026";
}
