<section id="timeline-hero-section" class="relative w-full min-h-screen flex items-center justify-center z-1 !px-6 !py-16">

    <div class="bg-dotted-pattern-edges min-h-screen h-full w-full absolute pointer-events-none"></div>
    

    <div class="absolute inset-0 overflow-hidden">
        <div class="absolute -left-20 top-20 h-96 w-96 rounded-full bg-pink-400/30 blur-3xl"></div>
        <div class="absolute right-10 top-40 h-80 w-80 rounded-full bg-purple-400/30 blur-3xl"></div>
        <div class="absolute bottom-10 left-1/3 h-96 w-96 rounded-full bg-blue-400/30 blur-3xl"></div>
    </div>

    <div class="flex flex-col items-center justify-center gap-4 z-5">
        <p class="page-title">The Timeline</p>
        <p class="!text-black text-center !m-0 !pb-[50px]">
            End the celebration with love, joy, and a beautiful send-off for the newlyweds. From the first hello to the last dance, here’s how our day unfolds.
        </p>

        <Timeline TimelineItems="@(timelineItems)" />
    </div>
</section>


