<section id="gallery-hero-section" class="gallery-hero-container relative w-full min-h-screen flex items-center justify-center z-1 !px-6 !py-16">

    <div class="bg-dotted-pattern-edges h-screen w-full absolute"></div>

    <div class="flex flex-col items-center justify-center gap-4 z-5">
        <p class="page-title">Our day through your Eyes</p>
        <p class="!text-black text-center !m-0">
            A collection of moments, memories, and little pieces of our day—captured through the eyes of the people who celebrated with us.
        </p>

        <p class="!text-black text-center !m-0 !pt-[30px]">See something we missed?</p>
        
        <button class="animated-btn red-btn" @onclick="OpenCamera">
            Capture a moment
        </button>
    </div>
</section>

<CameraModal @ref="_cameraModal" OnUploaded="OnUploaded" />

@code {
    [Parameter] public EventCallback<GFileDTO> OnUploaded { get; set; }

    private CameraModal? _cameraModal;

    private async Task OpenCamera()
    {
        if (_cameraModal is not null) await _cameraModal.Open();
    }
}