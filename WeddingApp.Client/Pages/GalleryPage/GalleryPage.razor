@page "/through-your-eyes"
<PageTitle>Through your eyes</PageTitle>

<div class="w-full overflow-x-hidden">
    <GalleryHeroSection OnUploaded="RefreshGallery" />
    <PhotoSection @ref="_photoSection" />
</div>

@code {
    private PhotoSection? _photoSection;

    private async Task RefreshGallery(GFileDTO uploadedPhoto)
    {
        if (_photoSection is not null) await _photoSection.Refresh(uploadedPhoto);
    }
}