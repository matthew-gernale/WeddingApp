
<section id="rsvp-section"
         class="relative flex min-h-screen w-full items-center justify-center
                overflow-hidden bg-[#550b14] !px-6 !py-16 sm:!px-10">

    <!-- Background -->
    <div class="bg-dotted-pattern-edges pointer-events-none absolute inset-0 h-full w-full"></div>

    <!-- Content -->
    <div class="relative z-10 flex w-full max-w-2xl flex-col items-center justify-center gap-6 text-center">

        <p class="page-title !text-white !m-0">
            Will You Join Us?
        </p>

        <p class="!m-0 text-center !text-white/80">
            We’d love to celebrate this special day with you.
            Kindly let us know if you’ll be joining us as we begin
            this beautiful chapter together. <br /> Please confirm your attendance by <strong>September 01, 2026</strong>
        </p>

        <!-- QR Code -->
        <div class="!mt-4 rounded-2xl bg-white p-4 shadow-xl">
            <img src="/images/qr/rsvp-qr.png"
                 alt="Scan to RSVP"
                 class="size-48 sm:size-56" />
        </div>

        <p class="!m-0 text-sm !text-white/70">
            Scan the QR code to RSVP
        </p>

        <!-- Divider -->
        <div class="flex w-full max-w-xs items-center gap-4">
            <div class="h-px flex-1 bg-white/20"></div>

            <span class="text-sm !text-white/60">
                or
            </span>

            <div class="h-px flex-1 bg-white/20"></div>
        </div>

        <!-- RSVP Button -->
        <RSVPModal
            GoogleFormUrl="@GoogleFormUrl"
            NameEntryId="@NameEntryId"
            AttendanceEntryId="@AttendanceEntryId"
            Guests="@GuestNames" />

    </div>

</section>


