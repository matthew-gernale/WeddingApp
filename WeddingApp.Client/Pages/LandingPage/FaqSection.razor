<section id="faq-section"
         class="bg-white relative w-full min-h-screen flex items-center justify-center z-1 !px-6 !py-16 sm:!px-10">

    <div class="flex flex-col items-center justify-center gap-[40px] z-5 w-full">

        <p class="page-title">
            A few things you may Wonder
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 w-full px-6 sm:px-10">

            @foreach(var item in faqItems)
            {
                <Card Question="@item.Question"
                      Answer="@item.Answer" />
            }

        </div>

    </div>

    <div class="bg-dotted-pattern-edges min-h-screen h-full w-full absolute"></div>

</section>


@code {
    List<(string Question, string Answer)> faqItems = new List<(string Question, string Answer)>
    {
        ("What is the dress code for the wedding?", "The dress code for our wedding is semi-formal. We encourage guests to dress elegantly, but feel free to express your personal style.\nPlease avoid wearing slippers, shorts, sleeveless undershirts (sando), and T-shirts with large or bold designs."),

        ("Are children allowed at the wedding?", "We love all of our friends and family's children! However, due to space restrictions we cannot accomodate underage guests on our wedding day, with the exception of children in the wedding entourage, we encourage you to use this evening/day to have fun date night/day."),

        ("Is there parking available at the venue?", "Yes! Parking spaces are available at the venue for our guests. Please feel free to bring your vehicle and follow the designated parking areas upon arrival."),

        ("Can I bring a plus one?", "In order to keep our event solemn and intimate, we are only able to accommodate guests named on this invite. We appreciate your kind understanding."),

        ("Can we sit anywhere at the wedding?", "We have assigned seats for each one of you. It took us a lot of effort and discussion to finalize the seating arrangement which is meant for everyone's convenience and group familiarity, so no need to worry. Our coordinators will gladly assist you in finding your designated seats."),
        
        ("What if i did not RSVP but will attended  the wedding?", "NO RSVP = NO SEAT. We will assign your seats so we strongly suggest you do the RSVP on or before September 1, 2026 or you may contact and intorm us ahead of time. In any case that you may have said Yes in our RSVP but suddenly won't be able to attend, please let us know ASAP so we can accommodate any changes."),

        ("What time should I arrive for the ceremony?", "We recommended arriving at least 30minutes before the ceremony begins to ensure you have time to find your seat and settle in.\nThe ceremony will strictly start at 2:00 PM. Entourage will march by 1:30 PM. Please be at the church at least 10-15 minutes before 1:30PM."),

        ("When can we leave?", "The program is estimated to last until 9PM. We are hoping that you will stay with us until the end of program. Should you wish to leave early, we'd love to personally thank you and bid goodbye before you go, perhaps not until the same day video is played."),
    };
}