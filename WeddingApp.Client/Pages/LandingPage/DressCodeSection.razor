<section id="dress-code-section" class="parallax-container w-screen z-1 relative">
    <div class="flex flex-col items-center justify-center gap-4 h-screen">
        <p class="page-title !text-white">What to wear?</p>

        <!-- Dress Code Filter Buttons -->
        <div class="flex flex-wrap justify-center gap-4">
            @foreach(var role in Enum.GetValues<Roles>())
            {
                <button class="@($"filter-button {(activeBtn == role ? "active" : "")}")" @onclick="() => FilterDressCodes(role)">@role.ToString()</button>
            }
        </div>

        <!-- Dress Code Display -->
        <div class="flex flex-col items-center justify-center gap-4 mt-8">
            @foreach(var dressCode in dressCodes.Where(dc => dc.Role == activeBtn))
            {
                <div class="flex flex-col items-center justify-center gap-4">
                    <div class="flex flex-wrap justify-center gap-4 mt-4">
                        @foreach(var attire in dressCode.Attires)
                        {
                            <div class="overflow-hidden size-50 rounded-lg">
                                <img src="@attire" alt="Dress Code Attire" class="cursor-pointer size-50 object-cover rounded-lg hover:scale-105 transition-transform duration-200" />
                            </div>
                        }
                    </div>

                    <div class="flex flex-wrap justify-center gap-[2px]">
                        @foreach(var palette in dressCode.ColorPalette)
                        {
                            <div class="size-20 shadow-md" style="@($"background-color: {palette};")"></div>
                        }
                    </div>
                    <p class="!text-white text-lg text-center max-w-xl">@dressCode.Description</p>
                </div>
            }
        </div>
    </div>
</section>


