@inject IJSRuntime JSRuntime

<section id="dress-code-section" class="parallax-container w-full z-1 relative !px-6 !py-16 sm:!px-10">
    <div class="flex flex-col items-center justify-center gap-4 min-h-screen">
        <p class="page-title !text-white">What to wear?</p>

        <!-- Dress Code Filter Buttons -->
        <div class="filter-container flex w-full max-w-fit min-w-0 flex-nowrap justify-start gap-4 overflow-x-auto !py-[10px] !px-[5px]">
            @foreach (var role in Enum.GetValues<Roles>())
            {
                <button id="@($"filter-{role}")" class="@($"filter-button shrink-0 {(activeBtn == role ? "active" : "")}")"
                        @onclick="() => FilterDressCodes(role)">
                    @role.ToString()
                </button>
            }
        </div> 

        <!-- Dress Code Display -->
        <div class="flex flex-col items-center justify-center gap-4 mt-8">
            @foreach(var dressCode in dressCodes.Where(dc => dc.Role == activeBtn))
            {
                <div class="flex flex-col items-center justify-center gap-4">
                    <div class="flex flex-wrap justify-center gap-3 mt-4 sm:gap-4">
                        @foreach(var attire in dressCode.Attires)
                        {
                            <div class="overflow-hidden size-24 rounded-lg xs:size-28 sm:size-36 md:size-50">
                                <img src="@attire" alt="Dress Code Attire" class="cursor-pointer size-24 object-cover rounded-lg hover:scale-105 transition-transform duration-200 xs:size-28 sm:size-36 md:size-50" />
                            </div>
                        }
                    </div>

                    <div class="flex flex-wrap justify-center gap-[2px]">
                        @foreach(var palette in dressCode.ColorPalette)
                        {
                            <div class="size-10 shadow-md sm:size-16 md:size-20" style="@($"background-color: {palette};")"></div>
                        }
                    </div>
                    <p class="!text-white text-sm sm:text-lg text-center max-w-xl">@dressCode.Description</p>
                </div>
            }
        </div>
    </div>
</section>


