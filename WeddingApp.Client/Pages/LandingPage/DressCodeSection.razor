            Description = "A timeless vision in beautiful white. Elegant, classic, and effortlessly graceful."
        },
        new DressCode {
            Role = Roles.GROOM,
            ColorPalette = new List<string> { "#462d26", "#FFFFFF", "#000000", "#550b14" },
            Attires = new List<string> { "images/dress-codes/groom/suit1.jpg", "images/dress-codes/groom/pants.jpg", "images/dress-codes/groom/shoes.jpg", "images/dress-codes/groom/accessories.jpg", "images/dress-codes/groom/glasses.jpg" },
            Description = "A sophisticated chocolate brown suit paired with a red tie. A warm and dashing look for the groom."
        },
        new DressCode {
            Role = Roles.FATHER,
            ColorPalette = new List<string> { "#70737a", "#FFFFFF", "#000000", "#550b14" },
            Attires = new List<string> { "images/dress-codes/father/suit.jpg", "images/dress-codes/father/tie.jpg", "images/dress-codes/father/shoes.jpg", "images/dress-codes/father/belt.jpg", "images/dress-codes/father/watch.jpg" },
            Description = "Silver gray with a touch of red for a polished and distinguished look."
        },
