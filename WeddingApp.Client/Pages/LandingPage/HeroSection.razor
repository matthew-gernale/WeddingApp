@inject IJSRuntime JS

<section id="hero-section"
         class="relative z-10 min-h-screen w-full !pt-[110px] !mt-[-75px]">

    <!-- Hero content -->

    <div class="mx-auto flex min-h-screen w-full flex-col">

        <!-- M -->
        <div class="flex items-start justify-between !ml-[-25px] md:!ml-[-40px] lg:!ml-[-60px]">
            <div class="hero-letter hero-m
                        font-[Cormorant_Garamond]
                        font-bolder
                        !text-[190px] md:!text-[300px] lg:!text-[420px] xl:!text-[520px]
                        leading-[0.7]
                        tracking-[-0.08em]
                        text-white">
                M
            </div>
        </div>

        <!-- Date -->
        <div class="flex flex-1 flex-col items-center justify-center text-center">

            <p class="!m-0 !text-[11px] xs:!text-sm sm:!text-lg !text-white font-[Montserrat] font-light tracking-[0.25em] sm:tracking-[0.3em] font-stretch-expanded w-fit">
                OCTOBER 08, 2026
            </p>

            <p class="!text-white !text-sm xs:!text-base sm:!text-xl md:!text-2xl font-[Montserrat] font-light tracking-[0.15em] sm:tracking-[0.3em] font-stretch-expanded !m-0 px-4 text-center">
                Matthew Gernale & Erika Joyce Gatchalian
            </p>

            <p class="!m-0 !text-[11px] xs:!text-sm sm:!text-lg !text-white font-[Montserrat] font-light tracking-[0.25em] sm:tracking-[0.3em] font-stretch-expanded w-fit">
                is getting married!
            </p>

        </div>

        <!-- E -->
        <div class="flex items-end justify-between gap-6
                    font-serif uppercase
                    !mb-[50px] lg:!mb-[90px]">

            <div></div>

            <div class="hero-letter hero-e
                        font-[Cormorant_Garamond]
                        font-bolder
                        !text-[190px] md:!text-[300px] lg:!text-[420px] xl:!text-[520px]
                        leading-[0.7]
                        tracking-[-0.08em]
                        !text-white">
                E
            </div>

        </div>

    </div>
</section>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initWeddingHero");
        }
    }
}