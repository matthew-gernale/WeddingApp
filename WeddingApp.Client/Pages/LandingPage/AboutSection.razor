<section id="about-section"
         class="bg-white relative w-full flex items-center justify-center z-1 !px-6 !py-16 sm:!px-10">

    <div class="relative z-5 flex w-full max-w-[1200px] flex-col items-center justify-center gap-4 px-6 sm:px-10">

        <p class="page-title">About this Website</p>

        <p class="!m-0 max-w-3xl text-center">
            This is the official wedding website of <strong>John Matthew Gernale</strong> and <strong>Erika Joyce Gatchalian</strong>,
            created to share the details of our wedding on <strong>October 08, 2026</strong> in Santa Maria, Bulacan
            with our family and friends.
        </p>

        <!-- Divider -->
        <div class="flex w-full max-w-xs items-center gap-4 !py-[20px]">
            <div class="h-px flex-1 bg-black/20"></div>
            <FlowerIcon Width="10px" Height="10px" />
            <div class="h-px flex-1 bg-black/20"></div>
        </div>

        <div class="grid w-full grid-cols-1 gap-4 sm:grid-cols-3">
            @foreach (var item in aboutItems)
            {
                <div class="flex flex-col items-center gap-2 rounded-2xl border border-[#dbdfd9] bg-white !p-6 text-center shadow-xl">
                    <p class="!m-0 !py-[6px] !px-[16px] rounded-full bg-[#FDEDEC] !text-[#550b14] text-[12px] uppercase tracking-[0.2em]">
                        @item.Title
                    </p>
                    <p class="!m-0 !text-[14px] !text-[#6B7369]">@item.Description</p>
                </div>
            }
        </div>

        <p class="!m-0 max-w-3xl text-center !text-[13px] !text-[#6B7369] !pt-[25px]">
            Guests never need to sign in with Google. Our gallery uses the Google Drive API only to store and display
            the photos shared with us in our own private wedding folder. Learn more in our
            <a href="/privacy-policy" class="!text-[#550b14] underline underline-offset-4">Privacy Policy</a>
            and <a href="/terms-of-service" class="!text-[#550b14] underline underline-offset-4">Terms of Service</a>.
        </p>

        <p class="!m-0 text-center !text-[13px] !text-[#6B7369]">
            Questions? Reach us at
            <a href="mailto:@ContactEmail" class="!text-[#550b14] underline underline-offset-4">@ContactEmail</a>
        </p>
    </div>

    <div class="bg-dotted-pattern-edges h-full w-full absolute pointer-events-none"></div>

</section>


@code {
    private const string ContactEmail = "matthewgernale26@gmail.com";

    List<(string Title, string Description)> aboutItems = new List<(string Title, string Description)>
    {
        ("Our Day", "Everything our guests need to know — the ceremony, reception, timeline, entourage, dress code, and seating."),
        ("RSVP", "A simple way for invited guests to confirm their attendance, submitted securely through Google Forms."),
        ("The Gallery", "A shared album where guests can upload and view photos from our celebration, stored in our private Google Drive.")
    };
}
