
<section id="entourage-section"
         class="seating-hero relative w-full min-h-screen flex items-center justify-center z-1 !py-16">

    <!-- Dotted edges -->
    <div class="bg-dotted-pattern-edges pointer-events-none absolute inset-0"></div>

    <div class="seating-hero__content !mx-auto w-full max-w-6xl !py-12">

        @* ======================================== *@
        @* HEADER *@
        @* ======================================== *@

        <div class="text-center">

            <p class="
                !text-xs
                uppercase
                tracking-[0.35em]
                !text-[#550b14]
            ">
                Reception
            </p>

            <h1 class="page-title
            ">
                Find Your Seat
            </h1>

            <p class="
                !mx-auto
                !mt-4
                max-w-lg
                !text-sm
                leading-relaxed
                !text-gray-500
            ">
                Search your name below to find your assigned table.
            </p>

        </div>


        @* ======================================== *@
        @* SEARCH *@
        @* ======================================== *@

        <div class="mx-auto !mt-10 w-full">

            <div class="
                flex
                overflow-hidden
                rounded-xl
                border
                border-gray-200
                bg-white
                shadow-sm
                transition-all
                duration-300
                focus-within:border-[#550b14]
            ">

                <input
                    @bind="searchText"
                    @bind:event="oninput"
                    @onkeydown="HandleKeyDown"
                    type="text"
                    autocomplete="off"
                    placeholder="Enter your name..."
                    class="
                        min-w-0
                        flex-1
                        border-0
                        bg-transparent
                        !px-6
                        !py-4
                        text-sm
                        text-gray-700
                        outline-none
                        placeholder:text-gray-400
                        focus:ring-0
                    " />

                <button
                    @onclick="FindGuest"
                    class="
                        !m-1
                        rounded-xl
                        bg-[#550b14]
                        !px-6
                        text-sm
                        font-medium
                        text-white
                        transition-all
                        duration-300
                        hover:bg-[#6b101c]
                        active:scale-95
                    ">
                    Search
                </button>

            </div>

            @if (showNoResult)
            {
                <p class="
                    !mt-4
                    text-center
                    !text-sm
                    !text-gray-500
                ">
                    We couldn't find a guest with that name.
                    Please try again.
                </p>
            }

        </div>


        @* ======================================== *@
        @* GUEST RESULT *@
        @* ======================================== *@

        @if (selectedGuest != null)
        {
            <div class="!mx-auto !mt-10 max-w-xl">

                <div class="
                    rounded-3xl
                    border
                    border-[#550b14]/10
                    bg-white
                    !p-8
                    text-center
                    shadow-sm
                ">

                    <p class="
                        !text-xs
                        uppercase
                        tracking-[0.3em]
                        !text-gray-400
                    ">
                        Welcome
                    </p>

                    <h2 class="
                        !mt-2
                        !text-3xl
                        !text-[#550b14]
                    ">
                        @selectedGuest.Name
                    </h2>


                    @* Role *@

                    <div class="!mt-5">

                        <span class="
                            inline-flex
                            rounded-full
                            bg-[#fbe2e5]
                            !px-4
                            !py-1.5
                            !text-[10px]
                            !font-semibold
                            uppercase
                            tracking-[0.18em]
                            !text-[#550b14]
                        ">
                            @GetRoleDisplayName(selectedGuest.Role)
                        </span>

                    </div>


                    @* Table *@

                    <div class="!mt-7">

                        <p class="
                            !text-xs
                            uppercase
                            tracking-[0.25em]
                            !text-gray-400
                        ">
                            Your Table
                        </p>

                        <p class="
                            !mt-1
                            !text-5xl
                            !font-semibold
                            !text-[#550b14]
                        ">
                            @selectedGuest.TableNumber
                        </p>

                    </div>


                    <div class="
                        !mx-auto
                        !mt-6
                        h-px
                        max-w-xs
                        bg-gray-100
                    ">
                    </div>


                    <p class="
                        !mt-5
                        !text-sm
                        leading-relaxed
                        !text-gray-500
                    ">
                        You may sit anywhere at your assigned table.
                    </p>

                </div>

            </div>


        }


        <!--

        @* ======================================== *@
        @* SEATING MAP *@
        @* ======================================== *@

        <div class="!mt-16">

            <div class="text-center">

                <p class="
                    !text-xs
                    uppercase
                    tracking-[0.3em]
                    !text-gray-400
                ">
                    Reception
                </p>

                <h2 class="
                    !mt-2
                    !text-2xl
                    !text-[#550b14]
                ">
                    Seating Arrangement
                </h2>

                <p class="
                    !mt-2
                    !text-sm
                    !text-gray-400
                ">
                    @(selectedGuest == null
                        ? "Search your name to highlight your assigned table."
                        : "Your assigned table is highlighted.")
                </p>

            </div>


            <div class="!mt-10 overflow-x-auto pb-8">

                <SeatingChart
                    Tables="tables"
                    SelectedTableNumber="@selectedGuest?.TableNumber" />

            </div>

        </div>
-->
    </div>

</section>


