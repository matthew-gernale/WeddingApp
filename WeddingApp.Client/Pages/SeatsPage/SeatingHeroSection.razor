        showNoResult = false;
        selectedGuest = null;

        if (string.IsNullOrWhiteSpace(searchText))
            return;

        var results = guests
            .Where(guest =>
                guest.Name.Contains(
                    searchText.Trim(),
                    StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (results.Count == 0)
        {
            showNoResult = true;
            return;
        }

        selectedGuest = results.First();
    }


    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") FindGuest();
    }


    // ==========================================
    // ROLE DISPLAY
    // ==========================================

    private string GetRoleDisplayName(Roles role)
    {
        if (selectedGuest?.Name == "Val Joseph Gatchalian") return "BEST MAN";
        else if (selectedGuest?.Name == "Abigail Manabat") return "MATRON OF HONOR";
        else if (selectedGuest?.Name == "Anne Maric Perez") return "MAID OF HONOR";

        return role switch
        {
            Roles.GODFATHER or Roles.GODMOTHER => "GOD PARENTS",
            Roles.GROOMSMEN => "GROOMSMEN",
            Roles.BRIDESMAID => "BRIDESMAIDS",
            Roles.FATHER or Roles.MOTHER => "PARENTS",
            Roles.GROOM => "GROOM",
            Roles.BRIDE => "BRIDE",
            Roles.GUEST => "GUEST",
            _ => "GUEST"
        };
    }

