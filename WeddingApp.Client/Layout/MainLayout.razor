@inherits LayoutComponentBase

<div class="wedding-app">
    <NavMenu />
    
    <main class="main-content">
        <article class="page-content">
            @Body
        </article>
    </main>
    
    <footer class="!py-3 !px-4 flex flex-col items-center justify-center gap-3 bg-[#550b14] relative sm:!p-[10px]">
        <div class="flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4">
            <p class="!m-0 text-center text-xs !text-white font-light sm:text-[15px]">Share the love! Please tag your photos and videos with us by using our official hashtag: <strong>#ERIKA</strong>foundherperfect<strong>MATT</strong>ch</p>

            <div class="flex flex-row items-center gap-3 sm:gap-4">
                <img src="images/icons/facebook.svg" alt="Facebook" class="w-5 h-5 sm:w-6 sm:h-6" />
                <img src="images/icons/instagram.svg" alt="Instagram" class="w-5 h-5 sm:w-6 sm:h-6" />
                <img src="images/icons/tiktok-dark.svg" alt="TikTok" class="w-5 h-5 sm:w-6 sm:h-6" />
            </div>
        </div>

        <div class="h-px w-full max-w-md bg-white/20"></div>

        <nav aria-label="Legal" class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 font-[Monospace] text-[11px] uppercase tracking-[0.2em]">
            <a href="/#about-section" class="!text-white/80 transition-colors duration-300 hover:!text-white">About</a>
            <span class="text-white/40">✦</span>
            <a href="/privacy-policy" class="!text-white/80 transition-colors duration-300 hover:!text-white">Privacy Policy</a>
            <span class="text-white/40">✦</span>
            <a href="/terms-of-service" class="!text-white/80 transition-colors duration-300 hover:!text-white">Terms of Service</a>
        </nav>
    </footer>

</div>
<Toast />
