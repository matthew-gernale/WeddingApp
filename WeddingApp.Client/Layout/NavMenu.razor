<header class="h-[60px] fixed top-0 z-50 w-screen bg-[#550b14] !px-[200px] !py-2 shadow-md sm:px-8">

    <div class="mx-auto flex h-full items-center justify-between">

        <!-- Logo -->
        <a href="/"
           class="shrink-0 transition-transform duration-300 hover:scale-105">
            <img src="images/logo/me-logo-white.png"
                 alt="Matthew & Erika"
                 class="!h-[60px] w-auto object-contain sm:h-24" />
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden items-center gap-10 md:flex">

            <a href="/seating"
               class="group relative font-[Montserrat] text-sm font-light uppercase tracking-[0.2em] !text-white/90 transition-colors duration-300 hover:text-white !m-0">
                Your seat Awaits

                <span class="absolute left-1/2 bottom-0 h-px w-0 -translate-x-1/2 bg-[#f0e6e1] transition-all duration-300 group-hover:w-full !m-0"></span>
            </a>

            <a href="/through-your-eyes"
               class="group relative font-[Montserrat] text-sm font-light uppercase tracking-[0.2em] !text-white/90 transition-colors duration-300 hover:text-white !m-0">
                Through Your Eyes

                <span class="absolute left-1/2 bottom-0 h-px w-0 -translate-x-1/2 bg-[#f0e6e1] transition-all duration-300 group-hover:w-full !m-0"></span>
            </a>

        </nav>

        <!-- Mobile Menu Button -->
        <button type="button"
                class="flex h-11 w-11 flex-col items-center justify-center gap-1.5 md:hidden"
                aria-label="Open navigation">

            <span class="h-px w-6 bg-white transition-all"></span>
            <span class="h-px w-6 bg-white transition-all"></span>
            <span class="h-px w-6 bg-white transition-all"></span>

        </button>

    </div>

</header>