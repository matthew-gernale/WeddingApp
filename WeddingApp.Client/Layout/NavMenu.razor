<header class="h-[60px] fixed top-0 z-50 w-full bg-[#550b14] !px-4 !py-2 shadow-md sm:!px-8 lg:!px-[100px] xl:!px-[200px]">

    <div class="mx-auto flex h-full items-center justify-between">

        <!-- Logo -->
        <a href="/"
           class="shrink-0 transition-transform duration-300 hover:scale-105">
            <img src="images/logo/me-logo-white.png"
                 alt="Matthew & Erika"
                 class="!h-[60px] w-auto object-contain" />
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden items-center gap-6 md:flex lg:gap-10">

            <a href="/"
               class="group relative font-[Monospace] !text-sm !font-light uppercase tracking-[0.2em] !text-white/90 transition-colors duration-300 hover:text-white !m-0">
                HOME

                <span class="absolute left-1/2 bottom-0 h-px w-0 -translate-x-1/2 bg-[#f0e6e1] transition-all duration-300 group-hover:w-full !m-0"></span>
            </a>

            <a href="/the-seats"
               class="group relative font-[Monospace] !text-sm !font-light uppercase tracking-[0.2em] !text-white/90 transition-colors duration-300 hover:text-white !m-0">
                The seats

                <span class="absolute left-1/2 bottom-0 h-px w-0 -translate-x-1/2 bg-[#f0e6e1] transition-all duration-300 group-hover:w-full !m-0"></span>
            </a>

            <a href="/the-timeline"
               class="group relative font-[Monospace] !text-sm !font-light uppercase tracking-[0.2em] !text-white/90 transition-colors duration-300 hover:text-white !m-0">
                The timeline

                <span class="absolute left-1/2 bottom-0 h-px w-0 -translate-x-1/2 bg-[#f0e6e1] transition-all duration-300 group-hover:w-full !m-0"></span>
            </a>

            <a href="/the-entourage"
               class="group relative font-[Monospace] !text-sm !font-light uppercase tracking-[0.2em] !text-white/90 transition-colors duration-300 hover:text-white !m-0">
                The entourage

                <span class="absolute left-1/2 bottom-0 h-px w-0 -translate-x-1/2 bg-[#f0e6e1] transition-all duration-300 group-hover:w-full !m-0"></span>
            </a>

            <a href="/through-your-eyes"
               class="group relative font-[Monospace] !text-sm !font-light uppercase tracking-[0.2em] !text-white/90 transition-colors duration-300 hover:text-white !m-0">
                The Gallery

                <span class="absolute left-1/2 bottom-0 h-px w-0 -translate-x-1/2 bg-[#f0e6e1] transition-all duration-300 group-hover:w-full !m-0"></span>
            </a>

        </nav>

        <!-- Mobile Menu Button -->
        <button type="button"
                @onclick="ToggleMobileMenu"
                class="flex h-11 w-11 flex-col items-center justify-center gap-1.5 md:hidden"
                aria-label="Toggle navigation"
                aria-expanded="@(isMobileMenuOpen ? "true" : "false")">

            <span class="@(isMobileMenuOpen ? "translate-y-[6.5px] rotate-45" : "") h-px w-6 bg-white transition-all"></span>
            <span class="@(isMobileMenuOpen ? "opacity-0" : "") h-px w-6 bg-white transition-all"></span>
            <span class="@(isMobileMenuOpen ? "-translate-y-[6.5px] -rotate-45" : "") h-px w-6 bg-white transition-all"></span>

        </button>

    </div>

    <!-- Mobile Navigation -->
    <nav class="@(isMobileMenuOpen ? "flex" : "hidden") absolute left-0 top-[60px] w-full flex-col items-center gap-2 bg-[#550b14] !py-4 shadow-md md:hidden">

        <a href="/" @onclick="CloseMobileMenu"
           class="w-full !py-3 text-center font-[Monospace] !text-sm !font-light uppercase tracking-[0.2em] !text-white/90 transition-colors duration-300 hover:bg-white/10 hover:!text-white !m-0">
            HOME
        </a>

        <a href="/the-seats" @onclick="CloseMobileMenu"
           class="w-full !py-3 text-center font-[Monospace] !text-sm !font-light uppercase tracking-[0.2em] !text-white/90 transition-colors duration-300 hover:bg-white/10 hover:!text-white !m-0">
            The seats
        </a>

        <a href="/the-timeline" @onclick="CloseMobileMenu"
           class="w-full !py-3 text-center font-[Monospace] !text-sm !font-light uppercase tracking-[0.2em] !text-white/90 transition-colors duration-300 hover:bg-white/10 hover:!text-white !m-0">
            The timeline
        </a>

        <a href="/the-entourage" @onclick="CloseMobileMenu"
           class="w-full !py-3 text-center font-[Monospace] !text-sm !font-light uppercase tracking-[0.2em] !text-white/90 transition-colors duration-300 hover:bg-white/10 hover:!text-white !m-0">
            The entourage
        </a>

        <a href="/through-your-eyes" @onclick="CloseMobileMenu"
           class="w-full !py-3 text-center font-[Monospace] !text-sm !font-light uppercase tracking-[0.2em] !text-white/90 transition-colors duration-300 hover:bg-white/10 hover:!text-white !m-0">
            The Gallery
        </a>

    </nav>

</header>

@code {
    private bool isMobileMenuOpen = false;

    private void ToggleMobileMenu() => isMobileMenuOpen = !isMobileMenuOpen;

    private void CloseMobileMenu() => isMobileMenuOpen = false;
}